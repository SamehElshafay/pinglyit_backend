APP_NAME=Pingly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:5183,http://localhost:5184

# JWT auth — generate a fresh secret per environment with:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=1440

# WhatsApp Gateway — Meta Cloud API (per docs §3.4). Leave blank until a real
# Meta app + WABA exist; WhatsAppGatewayService checks for these before calling out.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
# Any string you choose — also goes into Meta's webhook setup screen as "Verify Token".
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Lets a client connect their own WhatsApp number from user_website
# (WhatsAppEmbeddedSignupButton.vue) instead of an admin inserting a
# whatsapp_accounts row by hand. Requires Pingly to be registered as a Meta
# Tech Provider first — App Dashboard → WhatsApp → Embedded Signup →
# Configurations is where this Configuration ID comes from.
META_WHATSAPP_CONFIG_ID=

# AI Gateway — OpenRouter (per docs §4.1). Normally entered from the admin
# dashboard (AI Gateway → pricing → "OpenRouter connection"), encrypted in
# platform_settings — this var is only a fallback if both are blank the
# service stays a stub.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
AI_DEFAULT_MULTIPLIER=5

# Wallet top-up. Which gateway is active — this one line, not a secret, so
# it's fine here rather than the admin dashboard. Each gateway's own API
# keys below are the OPENROUTER_API_KEY pattern: normally entered from the
# admin dashboard (Billing → the matching "connection" screen), encrypted
# in platform_settings — these vars are only a fallback. Every gateway
# blank and WalletController::topup() returns a clean 501 until one is set.
PAYMENT_GATEWAY=paymob

# Paymob (docs §4.7, current pick — Egyptian, CBE-licensed, accepted an
# individual account with just a national ID + IBAN, no commercial register
# needed at this volume). PAYMOB_API_BASE defaults to Egypt's regional URL
# (accept.paymob.com) — see config/pingly.php if the merchant account is
# ever opened in a different Paymob-supported country instead.
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# The numeric Integration ID for "Online Card" (dashboard → Developers →
# Payment Integrations) — not a secret, but account-specific, so it's
# admin-managed the same way. "card" as a string is NOT accepted; confirmed
# live that Paymob wants this account's actual numeric ID here.
PAYMOB_INTEGRATION_ID=
# The Integration ID above is fixed to EGP, but the wallet is USD — this
# rate converts at the charge boundary only (PaymobGateway::usdToEgpRate()'s
# docblock). Admin-set, not fetched live; keep it roughly current.
PAYMOB_USD_TO_EGP_RATE=
PAYMOB_API_BASE=

# Tap Payments — originally the plan (Gulf-focused revenue, cards + Mada
# across the GCC), parked because Tap's own onboarding needs a bank account
# that doesn't exist yet. Switch PAYMENT_GATEWAY=tap to use these instead.
TAP_SECRET_KEY=
TAP_PUBLISHABLE_KEY=

# Cryptomus — accepts USDT/crypto at a hosted checkout page, no bank
# account or commercial register needed to onboard. CRYPTOMUS_API_KEY is
# the *Payment* API key specifically (Cryptomus dashboard → your project →
# API), not the separate Payout key. Switch PAYMENT_GATEWAY=cryptomus to
# use these instead.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Kept in case a Stripe-eligible entity ever exists — Stripe doesn't
# support an Egypt-based payout account today. Switch PAYMENT_GATEWAY=stripe
# to use these instead.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# "Sign in with Google" for user_website — usually set from the admin
# dashboard (platform_settings) instead; this var is only a fallback. Just
# a Client ID, no secret — from Google Cloud Console → Credentials → OAuth
# client ID (type "Web application"), with user_website's origin(s) added
# under Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=

# Where the hosted checkout page sends the client back to (user_website, not this API).
FRONTEND_URL=http://localhost:5184

# Hard ceiling ($) on what any single usage event can debit from a wallet —
# a circuit breaker against pricing bugs, not a normal pricing lever.
MAX_BILLED_PER_EVENT=5.00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pingly
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
