APP_NAME=Pingly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:5183,http://localhost:5184

# JWT auth — generate a fresh secret per environment with:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=1440

# WhatsApp Gateway — Meta Cloud API (per docs §3.4). Leave blank until a real
# Meta app + WABA exist; WhatsAppGatewayService checks for these before calling out.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
# Any string you choose — also goes into Meta's webhook setup screen as "Verify Token".
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# AI Gateway — OpenRouter (per docs §4.1). Same: blank = AiGatewayService stays a stub.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
AI_DEFAULT_MULTIPLIER=5

# Wallet top-up — international cards via Stripe Checkout (docs §4.7, decided).
# Leave the Stripe keys blank and WalletController::topup() returns a clean 501.
PAYMENT_GATEWAY=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout sends the client back to (user_website, not this API).
FRONTEND_URL=http://localhost:5184

# Hard ceiling ($) on what any single usage event can debit from a wallet —
# a circuit breaker against pricing bugs, not a normal pricing lever.
MAX_BILLED_PER_EVENT=5.00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pingly
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
